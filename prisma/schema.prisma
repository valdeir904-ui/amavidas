generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Evento {
  id          String   @id @default(cuid())
  tipo        String

  // ── ORIGEM DO LEAD ────────────────────────────────
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  gclid       String?
  fbclid      String?
  referrer    String?
  landingPage String?
  dispositivo String?

  criadoEm    DateTime @default(now())

  @@index([utmSource])
  @@map("eventos")
}

model Plano {
  id           String   @id @default(cuid())
  slug         String   @unique
  nome         String
  tagline      String
  preco        Int
  ativo        Boolean  @default(true)
  destaque     Boolean  @default(false)
  badge        String?
  icone        String   @default("?")
  beneficios   String   @db.Text
  ausentes     String   @db.Text
  cobertura    Int      @default(0)
  ordem        Int      @default(0)
  atualizadoEm DateTime @updatedAt
  criadoEm     DateTime @default(now())

  @@map("planos")
}

model Usuario {
  id           String    @id @default(cuid())
  nome         String
  email        String    @unique
  senhaHash    String
  ativo        Boolean   @default(true)
  perfil       String    @default("ATENDENTE")
  ultimoAcesso DateTime?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  simulacoes   Simulacao[]
  historicos   LeadHistorico[]

  @@map("usuarios")
}

model Configuracao {
  chave String @id
  valor String

  @@map("configuracoes")
}

model Simulacao {
  id                String          @id @default(cuid())
  nome              String
  email             String?         // Opcional agora
  telefone          String
  consentimento     Boolean         @default(false)
  consentimentoEm   DateTime?
  paraQuem          String
  quantidadePessoas String
  faixaEtaria       String
  cidade            String          @default("")
  prioridade        String
  orcamento         String
  intencao          String?
  planoRecomendado  String
  comoContatar      String          @default("")
  contatado         Boolean         @default(false)
  
  tipoPet           String?
  nomePet           String?
  portePet          String?
  idadePet          String?

  status            String          @default("novo_lead")
  
  motivoPerda       String?         @db.Text
  motivoDescarte    String?
  descarteObservacao String?

  temperaturaVenda  String?
  resumoNegociacao  String?         @db.Text
  objecaoPrincipal  String?
  proximoContatoEm  DateTime?
  
  primeiroContatoEm DateTime?
  responsavelId     String?
  responsavel       Usuario?        @relation(fields: [responsavelId], references: [id])
  
  origem            String          @default("simulador")

  // ── ORIGEM DO LEAD ────────────────────────────────
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmTerm        String?
  utmContent     String?
  gclid          String?
  fbclid         String?
  referrer       String?
  landingPage    String?
  dispositivo    String?

  nomeCompletoContrato String?
  numeroDependentes    String?
  planoContratado      String?
  contratoAssinado     Boolean         @default(false)
  valorAdesao          String?
  valorPlano           String?
  
  criadoEm          DateTime        @default(now())
  atualizadoEm      DateTime        @updatedAt
  notas             SimulacaoNota[]
  historico         LeadHistorico[]
  contratos         Contrato[]

  @@index([responsavelId], map: "simulacoes_responsavelId_fkey")
  @@index([utmSource])
  @@index([origem])
  @@map("simulacoes")
}

model SimulacaoNota {
  id          String    @id @default(cuid())
  simulacaoId String
  conteudo    String
  autor       String    @default("Administrador")
  criadoEm    DateTime  @default(now())
  simulacao   Simulacao @relation(fields: [simulacaoId], references: [id], onDelete: Cascade)

  @@index([simulacaoId], map: "simulacao_notas_simulacaoId_fkey")
  @@map("simulacao_notas")
}

model Depoimento {
  id           String   @id @default(cuid())
  nome         String
  cidade       String
  relacao      String?
  texto        String?  @db.Text
  tipo         String
  mediaUrl     String?
  fotoUrl      String?
  ativo        Boolean  @default(true)
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("depoimentos")
}

model Parceiro {
  id           String   @id @default(cuid())
  nome         String
  tipo         String
  desconto     String
  contato      String?
  logoUrl      String?  @db.Text
  ativo        Boolean  @default(true)
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("parceiros")
}

model LeadHistorico {
  id           String    @id @default(cuid())
  simulacaoId  String
  simulacao    Simulacao @relation(fields: [simulacaoId], references: [id], onDelete: Cascade)
  usuarioId    String
  usuario      Usuario   @relation(fields: [usuarioId], references: [id])
  acao         String    // "mudou_status" | "atribuiu" | "descartou" | "contatou" | "comentou"
  statusAntes  String?
  statusDepois String?
  observacao   String?
  criadoEm     DateTime  @default(now())

  @@index([simulacaoId])
  @@index([usuarioId])
  @@map("lead_historicos")
}

model SimulacaoIncompleta {
  id                String   @id @default(cuid())
  sessionId         String   @unique
  ultimaEtapa       Int
  paraQuem          String?
  quantidadePessoas String?
  faixaEtaria       String?
  cidade            String?
  prioridade        String?
  orcamento         String?
  intencao          String?

  tipoPet           String?
  nomePet           String?
  portePet          String?
  idadePet          String?

  // ── ORIGEM DO LEAD ────────────────────────────────
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmTerm        String?
  utmContent     String?
  gclid          String?
  fbclid         String?
  referrer       String?
  landingPage    String?
  dispositivo    String?

  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt

  @@index([utmSource])
  @@map("simulacoes_incompletas")
}

model Contrato {
  id                String   @id @default(cuid())
  numeroContrato    String   @unique
  tipoContratacao   String   @default("Nova contratação")
  portabilidade     Boolean  @default(false)
  natureza          String   @default("PF") // "PF" ou "PJ"
  
  // Plano
  plano             String
  valorAdesao       String?
  valorMensalidade  String?
  formaPagamento    String?
  cidadeAssinatura  String   @default("Águas Lindas de Goiás - GO")
  dataAssinatura    DateTime @default(now())

  // Titular PF
  titularNome       String
  titularCpf        String
  titularRg         String?
  titularEndereco   String?
  titularBairro     String?
  titularCidade     String?
  titularUf         String?
  titularCep        String?
  titularTelefone   String?
  titularEmail      String?

  // Titular PJ (se aplicável)
  pjRazaoSocial     String?
  pjCnpj            String?
  pjRepresentante   String?
  pjRepresentanteCpf String?
  pjRepresentanteRg String?

  // Beneficiários em formato JSON
  beneficiarios     String?  @db.Text
  observacoes       String?  @db.Text

  simulacaoId       String?
  simulacao         Simulacao? @relation(fields: [simulacaoId], references: [id], onDelete: SetNull)
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt

  @@index([simulacaoId])
  @@map("contratos")
}

model InvestimentoMarketing {
  id                   String   @id @default(cuid())
  mesAno               String   @unique // Formato "YYYY-MM" (ex: "2026-09")
  investimentoLeads    Float    @default(0) // R$ em campanha de geração de leads
  investimentoBranding Float    @default(0) // R$ em fortalecimento de marca / Instagram
  observacoes          String?  @db.Text
  criadoEm             DateTime @default(now())
  atualizadoEm         DateTime @updatedAt

  @@map("investimentos_marketing")
}

