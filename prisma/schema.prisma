generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Evento {
  id          String   @id @default(cuid())
  tipo        String

  // ── ORIGEM DO LEAD ────────────────────────────────
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  gclid       String?
  fbclid      String?
  referrer    String?
  landingPage String?
  dispositivo String?

  criadoEm    DateTime @default(now())

  @@index([utmSource])
  @@map("eventos")
}

model Plano {
  id           String   @id @default(cuid())
  slug         String   @unique
  nome         String
  tagline      String
  preco        Int
  ativo        Boolean  @default(true)
  destaque     Boolean  @default(false)
  badge        String?
  icone        String   @default("?")
  beneficios   String   @db.Text
  ausentes     String   @db.Text
  cobertura    Int      @default(0)
  ordem        Int      @default(0)
  atualizadoEm DateTime @updatedAt
  criadoEm     DateTime @default(now())

  @@map("planos")
}

model Usuario {
  id           String    @id @default(cuid())
  nome         String
  email        String    @unique
  senhaHash    String
  ativo        Boolean   @default(true)
  perfil       String    @default("ATENDENTE")
  ultimoAcesso DateTime?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  simulacoes   Simulacao[]
  historicos   LeadHistorico[]

  @@map("usuarios")
}

model Configuracao {
  chave String @id
  valor String

  @@map("configuracoes")
}

model Simulacao {
  id                String          @id @default(cuid())
  nome              String
  email             String?         // Opcional agora
  telefone          String
  consentimento     Boolean         @default(false)
  consentimentoEm   DateTime?
  paraQuem          String
  quantidadePessoas String
  faixaEtaria       String
  cidade            String          @default("")
  prioridade        String
  orcamento         String
  intencao          String?
  planoRecomendado  String
  comoContatar      String          @default("")
  contatado         Boolean         @default(false)
  
  status            String          @default("novo_lead")
  
  motivoPerda       String?         @db.Text
  motivoDescarte    String?
  descarteObservacao String?
  
  primeiroContatoEm DateTime?
  responsavelId     String?
  responsavel       Usuario?        @relation(fields: [responsavelId], references: [id])
  
  origem            String          @default("simulador")

  // ── ORIGEM DO LEAD ────────────────────────────────
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmTerm        String?
  utmContent     String?
  gclid          String?
  fbclid         String?
  referrer       String?
  landingPage    String?
  dispositivo    String?

  nomeCompletoContrato String?
  numeroDependentes    String?
  planoContratado      String?
  contratoAssinado     Boolean         @default(false)
  valorAdesao          String?
  valorPlano           String?
  
  criadoEm          DateTime        @default(now())
  atualizadoEm      DateTime        @updatedAt
  notas             SimulacaoNota[]
  historico         LeadHistorico[]

  @@index([responsavelId], map: "simulacoes_responsavelId_fkey")
  @@index([utmSource])
  @@index([origem])
  @@map("simulacoes")
}

model SimulacaoNota {
  id          String    @id @default(cuid())
  simulacaoId String
  conteudo    String
  autor       String    @default("Administrador")
  criadoEm    DateTime  @default(now())
  simulacao   Simulacao @relation(fields: [simulacaoId], references: [id], onDelete: Cascade)

  @@index([simulacaoId], map: "simulacao_notas_simulacaoId_fkey")
  @@map("simulacao_notas")
}

model Depoimento {
  id           String   @id @default(cuid())
  nome         String
  cidade       String
  relacao      String?
  texto        String?  @db.Text
  tipo         String
  mediaUrl     String?
  fotoUrl      String?
  ativo        Boolean  @default(true)
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("depoimentos")
}

model Parceiro {
  id           String   @id @default(cuid())
  nome         String
  tipo         String
  desconto     String
  contato      String?
  logoUrl      String?  @db.Text
  ativo        Boolean  @default(true)
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("parceiros")
}

model LeadHistorico {
  id           String    @id @default(cuid())
  simulacaoId  String
  simulacao    Simulacao @relation(fields: [simulacaoId], references: [id], onDelete: Cascade)
  usuarioId    String
  usuario      Usuario   @relation(fields: [usuarioId], references: [id])
  acao         String    // "mudou_status" | "atribuiu" | "descartou" | "contatou" | "comentou"
  statusAntes  String?
  statusDepois String?
  observacao   String?
  criadoEm     DateTime  @default(now())

  @@index([simulacaoId])
  @@index([usuarioId])
  @@map("lead_historicos")
}

model SimulacaoIncompleta {
  id                String   @id @default(cuid())
  sessionId         String   @unique
  ultimaEtapa       Int
  paraQuem          String?
  quantidadePessoas String?
  faixaEtaria       String?
  cidade            String?
  prioridade        String?
  orcamento         String?
  intencao          String?

  // ── ORIGEM DO LEAD ────────────────────────────────
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmTerm        String?
  utmContent     String?
  gclid          String?
  fbclid         String?
  referrer       String?
  landingPage    String?
  dispositivo    String?

  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt

  @@index([utmSource])
  @@map("simulacoes_incompletas")
}

