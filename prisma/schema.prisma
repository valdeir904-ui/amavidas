generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Evento {
  id       String   @id @default(cuid())
  tipo     String
  criadoEm DateTime @default(now())

  @@map("eventos")
}

model Plano {
  id           String   @id @default(cuid())
  slug         String   @unique
  nome         String
  tagline      String
  preco        Int
  ativo        Boolean  @default(true)
  destaque     Boolean  @default(false)
  badge        String?
  icone        String   @default("?")
  beneficios   String   @db.Text
  ausentes     String   @db.Text
  cobertura    Int      @default(0)
  ordem        Int      @default(0)
  atualizadoEm DateTime @updatedAt
  criadoEm     DateTime @default(now())

  @@map("planos")
}

model Usuario {
  id           String    @id @default(cuid())
  nome         String
  email        String    @unique
  senhaHash    String
  ativo        Boolean   @default(true)
  ultimoAcesso DateTime?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  @@map("usuarios")
}

model Configuracao {
  chave String @id
  valor String

  @@map("configuracoes")
}

model Simulacao {
  id                String          @id @default(cuid())
  nome              String
  email             String
  telefone          String
  paraQuem          String
  quantidadePessoas String
  faixaEtaria       String
  prioridade        String
  orcamento         String
  planoRecomendado  String
  cidade            String          @default("")
  comoContatar      String          @default("")
  contatado         Boolean         @default(false)
  status            String          @default("pendente")
  criadoEm          DateTime        @default(now())
  atualizadoEm      DateTime        @updatedAt
  notas             SimulacaoNota[]

  @@map("simulacoes")
}

model SimulacaoNota {
  id          String    @id @default(cuid())
  simulacaoId String
  conteudo    String
  autor       String    @default("Administrador")
  criadoEm    DateTime  @default(now())
  simulacao   Simulacao @relation(fields: [simulacaoId], references: [id], onDelete: Cascade)

  @@index([simulacaoId], map: "simulacao_notas_simulacaoId_fkey")
  @@map("simulacao_notas")
}

model Depoimento {
  id           String   @id @default(cuid())
  nome         String
  cidade       String
  relacao      String?
  texto        String?  @db.Text
  tipo         String
  mediaUrl     String?
  fotoUrl      String?
  ativo        Boolean  @default(true)
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("depoimentos")
}

model Parceiro {
  id           String   @id @default(cuid())
  nome         String
  tipo         String
  desconto     String
  contato      String?
  logoUrl      String?  @db.Text
  ativo        Boolean  @default(true)
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("parceiros")
}
