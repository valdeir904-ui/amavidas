generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Evento {
  id        String   @id @default(cuid())
  tipo      String   // "visita" | "simulacao_iniciada" | "whatsapp_clicado"
  criadoEm DateTime @default(now())

  @@map("eventos")
}

model Plano {
  id           String   @id @default(cuid())
  slug         String   @unique  // "essencial" | "familia" | "premium"
  nome         String
  tagline      String
  preco        Int               // valor em reais/mês
  ativo        Boolean  @default(true)
  destaque     Boolean  @default(false)
  badge        String?
  icone        String   @default("📄")
  beneficios   String            // JSON: string[]
  ausentes     String            // JSON: string[] (itens não inclusos)
  cobertura    Int      @default(0) // valor em reais da cobertura
  ordem        Int      @default(0)
  atualizadoEm DateTime @updatedAt
  criadoEm     DateTime @default(now())

  @@map("planos")
}

model Usuario {
  id           String   @id @default(cuid())
  nome         String
  email        String   @unique
  senhaHash    String
  ativo        Boolean  @default(true)
  ultimoAcesso DateTime?
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("usuarios")
}

model Configuracao {
  chave String @id
  valor String

  @@map("configuracoes")
}

model Simulacao {
  id               String   @id @default(cuid())
  nome             String
  email            String
  telefone         String
  paraQuem         String
  quantidadePessoas String
  faixaEtaria      String
  prioridade       String
  orcamento        String
  planoRecomendado String
  contatado        Boolean  @default(false)
  status           String   @default("pendente") // "pendente" | "contatado" | "ganho" | "perdido"
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt
  notas            SimulacaoNota[]

  @@map("simulacoes")
}

model SimulacaoNota {
  id          String    @id @default(cuid())
  simulacaoId String
  simulacao   Simulacao @relation(fields: [simulacaoId], references: [id], onDelete: Cascade)
  conteudo    String
  autor       String    @default("Administrador")
  criadoEm    DateTime  @default(now())

  @@map("simulacao_notas")
}

